# Copy to .env.local, fill in the variables for your selected workflow, then:
# set -a; source .env.local; set +a
# Run from the repository root; use absolute paths for remote data locations.
RP_DATA_ROOT="$PWD/robocasa_data_ckpt"
OPENPI_DATA_HOME="$PWD/.cache/openpi"
ROBOPROMPT_HARDWARE_CONFIG="$PWD/hardware/config/flexiv.local.json"
