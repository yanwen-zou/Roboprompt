POLICY_HOST=127.0.0.1
POLICY_PORT=8000
PORT=8000
EVO1_CKPT=
PI05_CKPT=
PI05_CONFIG=
DP_CKPT=
DP_CONFIG=
FASTWAM_CKPT=
FASTWAM_CONFIG=
FASTWAM_STATS=
